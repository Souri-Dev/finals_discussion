{% extends 'base.html.twig' %}

{% block title %}Welcome
{% endblock %}

{% block body %}
	<div style="display: flex; justify-content: center; align-items: center; min-height: 100vh; background-color: var(--color-background);">
		<div style="background-color: white; padding: 3rem; border-radius: 1rem; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); max-width: 600px; width: 100%; text-align: center;">
			<h1 style="color: var(--color-primary); font-family: var(--font-family-display); font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">
				Welcome
				{% if app.user %},
					{{ app.user.userIdentifier }}
				{% endif %}!
			</h1>
			<p style="color: var(--color-text-muted); font-size: 1.125rem; line-height: 1.75rem; margin-bottom: 2rem;">
				{% if app.user %}
					You are successfully logged in. Explore our products and manage your account.
				{% else %}
					Please log in to access all features.
				{% endif %}
			</p>
			<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
				{% if app.user %}
					<a href="/product" class="fs-button" style="text-decoration: none; display: inline-block;">View Products</a>
					<a href="{{ path('app_logout') }}" class="fs-button" style="text-decoration: none; display: inline-block; background-color: var(--color-background-alt);">Logout</a>
				{% else %}
					<a href="/login" class="fs-button" style="text-decoration: none; display: inline-block;">Login</a>
					<a href="/register" class="fs-button" style="text-decoration: none; display: inline-block; background-color: var(--color-background-alt);">Register</a>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}


