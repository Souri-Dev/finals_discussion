{% extends 'base.html.twig' %}

{% block title %}Access Denied - Insufficient Permissions{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <h1 class="display-1 text-danger">403</h1>
                <h2 class="mb-4">Access Denied</h2>
                <p class="lead">You lack the necessary permissions to access this resource.</p>
                
                {% if status_text is defined %}
                    <div class="alert alert-warning mt-3">
                        {{ status_text }}
                    </div>
                {% endif %}
                
                <p class="text-muted mt-3">
                    This page requires elevated privileges. If you believe you should have access, 
                    please contact your system administrator.
                </p>
                
                <div class="mt-4">
                    <a href="{{ path('app_home') }}" class="btn btn-primary">
                        <i class="bi bi-house"></i> Return to Homepage
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
